  "SandboxPool": {
    "PoolSize": 4,
    "ExecutorType": "container-v1",
    "ContainerImage": "aos-sandbox-worker:local",
    "MemoryLimitMb": 192,
    "CpuLimit": 0.5,
    "PidsLimit": 32,
    "TmpfsSizeMb": 16
  },
  "AllowedHosts": "*"
}
