{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "EventLog": {
    "Directory": "data",
    "FileName": "eventlog.jsonl",
    "HmacKey": "local-dev-hmac-key",
    "HmacKeyId": "local-dev"
  },
  "CapabilityTokens": {
    "Issuer": "aos.local",
    "Audience": "aos.tools",
    "SigningKey": "local-dev-capability-key-change-me-32-bytes",
    "KeyId": "local-capability-v1",
    "LifetimeSeconds": 300
  },
  "HelloWorkflow": {
    "Routing": {
      "TaskClass": "workflow.hello",
      "MaxLatencyMs": 220,
      "MaxCostPer1KTokens": 0.5,
      "MinQualityScore": 60,
      "RequiredComplianceTags": [ "eu", "standard" ]
    },
    "Models": [
      {
        "ModelId": "openai-gpt-4.1-mini",
        "Provider": "openai",
        "Version": "2026-02"
      }
    ],
    "Tools": [
      {
        "ToolId": "web-search",
        "Version": "1.0"
      }
    ],
    "PolicyDecisions": [
      {
        "PolicyId": "allow-approved-tools",
        "Decision": "allow",
        "Reason": "configured default policy"
      }
    ]
  },
  "PlannerWorkflow": {
    "Routing": {
      "MaxLatencyMs": 220,
      "MaxCostPer1KTokens": 0.5,
      "MinQualityScore": 60,
      "RequiredComplianceTags": [ "eu", "standard" ]
    },
    "AllowedActions": [
      {
        "ActionId": "echo.message",
        "ToolId": "planner-echo",
        "ToolVersion": "1.0",
        "Arguments": [
          { "Name": "message", "Required": true },
          { "Name": "note", "Required": false }
        ]
      }
    ],
    "Playbooks": [
      {
        "SchemaVersion": "0.1",
        "PlaybookId": "echo-one-step",
        "Version": "1",
        "TaskClass": "workflow.plan",
        "Description": "Echo one planner message",
        "RetrievalTerms": [ "echo", "single" ],
        "Steps": [
          {
            "ActionId": "echo.message",
            "ArgumentTemplates": { "message": "{{message}}" }
          }
        ]
      },
      {
        "SchemaVersion": "0.1",
        "PlaybookId": "echo-two-step",
        "Version": "1",
        "TaskClass": "workflow.plan",
        "Description": "Echo two planner messages in sequence",
        "RetrievalTerms": [ "echo", "sequence", "two-step" ],
        "Steps": [
          {
            "ActionId": "echo.message",
            "ArgumentTemplates": { "message": "{{message}}" }
          },
          {
            "ActionId": "echo.message",
            "ArgumentTemplates": { "message": "complete" }
          }
        ]
      },
      {
        "SchemaVersion": "0.1",
        "PlaybookId": "echo-with-note",
        "Version": "1",
        "TaskClass": "workflow.plan",
        "Description": "Echo required and optional planner arguments",
        "RetrievalTerms": [ "echo", "optional", "note" ],
        "Steps": [
          {
            "ActionId": "echo.message",
            "ArgumentTemplates": { "message": "{{message}}", "note": "{{note}}" }
          }
        ]
      }
    ],
    "PolicyDecisions": [
      {
        "PolicyId": "planner-validated-actions-only",
        "Decision": "allow",
        "Reason": "plan passed the allowed-action validator"
      }
    ]
  },
  "Router": {
    "Weights": {
